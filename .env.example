# Telegram credentials — keep real values out of GitHub
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polling interval between scans, in seconds
SCAN_INTERVAL_SECONDS=60

# Target candle timeframe
TIMEFRAME=15m

# Keep false until strategy signals have been compared against TradingView
SCANNER_ENABLED=true
USE_TREND_FILTER=false
USE_SMA200_FILTER=false
USE_BREAK_EVEN=true
USE_TRAILING_STOP=true
